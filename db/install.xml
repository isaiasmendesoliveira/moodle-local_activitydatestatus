<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/activitydatestatus/db" VERSION="2026090400" COMMENT="XMLDB file for local_activitydatestatus"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd">
  <TABLES>
    <TABLE NAME="local_activitydatestatus" COMMENT="Per-course-module Activity Date Status presentation settings">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="cmid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Course module id"/>
        <FIELD NAME="enabled" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Whether the indicator is enabled"/>
        <FIELD NAME="displaymode" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="both" SEQUENCE="false" COMMENT="dates, status or both"/>
        <FIELD NAME="warninghours" TYPE="int" LENGTH="6" NOTNULL="true" DEFAULT="48" SEQUENCE="false" COMMENT="Attention threshold in hours; zero disables"/>
        <FIELD NAME="criticalhours" TYPE="int" LENGTH="6" NOTNULL="true" DEFAULT="12" SEQUENCE="false" COMMENT="Critical threshold in hours; zero disables"/>
        <FIELD NAME="statusstyle" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="badge" SEQUENCE="false" COMMENT="badge or text status presentation"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="cmid_uniq" TYPE="unique" FIELDS="cmid"/>
      </KEYS>
    </TABLE>
  </TABLES>
</XMLDB>
